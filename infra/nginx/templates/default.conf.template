# Edge reverse proxy: TLS termination + routing to the app and web containers (§19.1).
# ${DOMAIN} is substituted by the official nginx image's built-in envsubst-on-start behavior
# (any *.template file under /etc/nginx/templates/ is rendered to /etc/nginx/conf.d/ on boot),
# driven by the DOMAIN env var set in infra/docker-compose.prod.yml.

server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt HTTP-01 challenge (infra/nginx/init-letsencrypt.sh, the certbot service).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 5m;

    # §3.7: health/ready are excluded from the /api/v1 prefix so they can be probed without
    # any API versioning knowledge.
    location /health {
        proxy_pass http://app:3000/health;
    }

    location /ready {
        proxy_pass http://app:3000/ready;
    }

    location /api/ {
        proxy_pass http://app:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # §5.10: the realtime gateway attaches a raw `ws` server at /ws, outside the /api/v1
    # prefix (apps/api/src/main.ts) — needs the Upgrade/Connection headers forwarded, which the
    # plain /api/ block above does not send.
    location /ws {
        proxy_pass http://app:3000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://web:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
