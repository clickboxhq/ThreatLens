# Copy to .env and fill in for local development (§5.17, §5.18).
# Never commit the real .env file.

NODE_ENV=development

# Database (§6, §19.1) — matches infra/docker-compose.yml's postgres service
DATABASE_URL=postgresql://socverse:socverse_dev_password@localhost:5432/socverse

# Redis (§5.4, §5.9, §5.10) — cache, queue broker, pub/sub
REDIS_URL=redis://localhost:6379

# Object storage (§5.11) — MinIO in dev, S3-compatible
OBJECT_STORAGE_ENDPOINT=localhost
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_ACCESS_KEY=socverse
OBJECT_STORAGE_SECRET_KEY=socverse_dev_password

# Auth (§5.7, §15.1)
JWT_ACCESS_SECRET=dev-only-change-me-access
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

PORT=3000
