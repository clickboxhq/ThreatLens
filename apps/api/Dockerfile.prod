# Built from the REPO ROOT (see infra/docker-compose.prod.yml's `context: ..`), not from
# apps/api/ — this is an npm workspaces monorepo with a single package-lock.json at the root,
# so `npm ci` (which requires a lockfile in its own directory) only works run from there. The
# dev Dockerfile alongside this one uses `npm install` instead specifically to sidestep that,
# at the cost of not being a reproducible, lockfile-pinned install — acceptable for local dev,
# not for what actually ships to production.

# ---- build: compiles dist/ and generates the Prisma client with full devDependencies ----
FROM node:22-alpine AS build
WORKDIR /repo
RUN apk add --no-cache openssl
COPY package*.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci
COPY apps/api apps/api
RUN npx prisma generate --schema apps/api/prisma/schema.prisma
RUN npm run build --workspace=apps/api

# ---- production: runtime only ----
# Copies the full node_modules from `build` rather than a separate --omit=dev install: a fresh
# prod-only `npm ci` re-triggers @prisma/client's postinstall generate step without the
# `prisma` devDependency present to run it. Reusing the already-generated node_modules avoids
# that fragility at the cost of a larger image — and as a side effect, the `prisma` CLI is
# actually present here too (verified: `docker run ... npx prisma --version` works), which
# infra/docker-compose.prod.yml doesn't rely on (migrations run via the separate `build`-stage
# `migrate` service there) but infra/RAILWAY.md does, running migrations directly against this
# image via `railway run` since Railway has no equivalent to a one-off compose service.
FROM node:22-alpine AS production
RUN apk add --no-cache openssl
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
COPY --from=build --chown=app:app /repo/node_modules ./node_modules
# npm workspaces doesn't hoist every dependency to the root node_modules — a package only one
# workspace needs (e.g. sanitize-html) can end up nested under that workspace's own
# node_modules instead. This COPY merges into the destination above rather than replacing it,
# so both hoisted and workspace-nested packages end up present at runtime.
COPY --from=build --chown=app:app /repo/apps/api/node_modules ./node_modules
COPY --from=build --chown=app:app /repo/apps/api/dist ./dist
COPY --from=build --chown=app:app /repo/apps/api/prisma ./prisma
COPY --from=build --chown=app:app /repo/apps/api/package.json ./package.json
# Not used by the api/worker services themselves — present so `railway run --service api sh
# scripts/provision-app-role.sh` (infra/RAILWAY.md) can run migrations directly against this
# image, the same script infra/docker-compose.prod.yml's separate `migrate` service runs.
COPY --from=build --chown=app:app /repo/apps/api/scripts ./scripts
# Same reason: `prisma db seed` shells out to `ts-node prisma/seed.ts`, and without a tsconfig
# beside it ts-node falls back to its own defaults rather than the settings this code is
# actually compiled under. Seeding is a deliberate one-off (`railway ssh --service api -- npm
# run prisma:seed`), not part of the start command, so this file is the only thing standing
# between that command working and it failing on a container nobody can easily debug.
COPY --from=build --chown=app:app /repo/apps/api/tsconfig.json ./tsconfig.json
USER app
ENV NODE_ENV=production
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1
CMD ["node", "dist/src/main"]
