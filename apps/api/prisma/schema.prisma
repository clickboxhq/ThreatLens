// SOCVerse — Prisma schema (walking-skeleton subset of docs/SOCVerse-Architecture.md §6)
// Only the tables needed for the "Phishing -> Stolen Credentials -> Risky Sign-in" skeleton
// scenario are modeled here. Breadth (Device Portal event tables, Instructor Mode, Learning
// Platform, etc.) is added incrementally following the same conventions (§6.1).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // §15.9 defense-in-depth: the running app connects as a least-privilege role (`url`).
  // `prisma migrate`/`db push` instead use `directUrl`, which points at the DB owner role that
  // actually has DDL rights — see 20260806_add_least_privilege_app_role for why this split exists.
  directUrl  = env("MIGRATE_DATABASE_URL")
  extensions = [citext]
}

// ---------- §6.1 shared conventions ----------
// - UUID v4 primary keys, application-generated (Prisma `uuid()`), per §6.1.
// - `deletedAt` soft delete on compliance-weight tables (users); hard delete elsewhere.
// - Every synthetic/session-scoped table carries `sessionId` (§6.2).

// ---------- Identity & Access (§6.3, §6.4, §6.19) ----------

enum UserRole {
  student
  instructor
  org_admin
  platform_admin
}

enum UserStatus {
  active
  suspended
  pending_verification
}

model Organization {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  teamSize   Int?     @map("team_size")
  industry   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  users   User[]
  invites OrganizationInvite[]

  @@map("organizations")
}

enum ExperienceLevel {
  new_to_security
  early_career
  experienced
  career_switcher
}

enum AvatarType {
  initials
  preset
  upload
}

// l1 -> l2 -> senior. Deterministic promotion, evaluated the same way
// AchievementKey is: pure functions over scored session history, no manual
// self-selection (see career-progression module).
enum CareerLevel {
  l1
  l2
  senior
}

enum OrganizationInviteStatus {
  pending
  accepted
  revoked
}

// §Phase 6 (merge plan): the org multi-tenancy this session builds out. An invite is scoped to
// one email address and one role (student or instructor only — org_admin/platform_admin are
// never grantable by invite, same privilege-escalation boundary signup itself enforces). Kept
// as a real, queryable row (unlike the Redis-ephemeral auth tokens in email-verification-token
// .store.ts) because an org_admin needs to see and revoke pending invites, not just consume
// them once.
model OrganizationInvite {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  email          String                   @db.Citext
  role           UserRole                 @default(student)
  token          String                   @unique
  status         OrganizationInviteStatus @default(pending)
  invitedBy      String                   @map("invited_by") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at")
  expiresAt      DateTime                 @map("expires_at")
  acceptedAt     DateTime?                @map("accepted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("OrganizationInviteInviter", fields: [invitedBy], references: [id])

  @@index([organizationId])
  @@map("organization_invites")
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  orgId                String?    @map("org_id") @db.Uuid
  email                String     @unique @db.Citext
  passwordHash         String?    @map("password_hash")
  role                 UserRole   @default(student)
  displayName          String     @map("display_name")
  status               UserStatus @default(active)
  emailVerifiedAt      DateTime?  @map("email_verified_at")
  sessionVersion       Int        @default(1) @map("session_version")
  lastLoginAt          DateTime?  @map("last_login_at")
  // §15.1: TOTP-based MFA. mfaSecret is written at /auth/mfa/setup (pending) and only takes
  // effect once mfaEnabled flips true at /auth/mfa/enable. Recovery codes are stored hashed
  // (sha256) and consumed one-time, same spirit as the recovery-code pattern used elsewhere
  // (§15.3 scopes app-layer field encryption to sso_config/payment tokens, not this table,
  // so mfaSecret relies on disk-level encryption like the rest of the schema).
  mfaEnabled           Boolean    @default(false) @map("mfa_enabled")
  mfaSecret            String?    @map("mfa_secret")
  mfaRecoveryCodesHash String[]   @default([]) @map("mfa_recovery_codes_hash")

  // Profile — all optional/additive, collected post-signup (see /welcome).
  // displayName above remains the name shown everywhere already built
  // against it; firstName/lastName are independently editable, not merely
  // a split of displayName.
  firstName        String? @map("first_name")
  lastName         String? @map("last_name")
  professionalRole String? @map("professional_role")
  bio              String?
  careerGoal       String? @map("career_goal")
  experienceLevel  ExperienceLevel? @map("experience_level")

  // Avatar — three modes. `avatarDataUrl` holds an uploaded image as a
  // size-capped (~2MB) base64 data URL directly in Postgres rather than via
  // object storage: MinIO is provisioned in infra but has no application
  // code anywhere touching it yet, and wiring a full bucket/policy/client
  // pipeline for a small profile image is disproportionate — this is a
  // deliberate, documented scope trade-off, not an oversight.
  avatarType       AvatarType @default(initials) @map("avatar_type")
  avatarPresetKey  String?    @map("avatar_preset_key")
  avatarDataUrl    String?    @map("avatar_data_url")

  // SOC Career Progression (§ enterprise upgrade) — deterministic, computed
  // from scored session history the same way achievements are, never
  // user-selected directly.
  careerLevel CareerLevel @default(l1) @map("career_level")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization          Organization?              @relation(fields: [orgId], references: [id])
  refreshTokens         RefreshToken[]
  investigationSessions InvestigationSession[]
  authoredScenarios     AttackScenario[]           @relation("ScenarioAuthor")
  authoredVersions      ScenarioVersion[]          @relation("ScenarioVersionAuthor")
  pinnedEvidence        EvidenceCollection[]
  timelineItems         TimelineItem[]
  analystNotes          AnalystNote[]
  investigationActions  InvestigationAction[]
  ownedCohorts          Cohort[]                   @relation("CohortOwner")
  cohortEnrollments     CohortEnrollment[]         @relation("CohortEnrollments")
  createdAssignments    CohortScenarioAssignment[] @relation("AssignmentCreator")
  instructorFeedback    InstructorFeedback[]       @relation("InstructorFeedbackAuthor")
  certificates          Certificate[]
  achievements          Achievement[]
  auditLogs             AuditLog[]
  sentOrgInvites        OrganizationInvite[]       @relation("OrganizationInviteInviter")
  notifications         Notification[]

  @@map("users")
}

// ---------- Audit Logging (§6.22, §15.9) ----------

// Platform-wide, security/compliance-relevant action log — distinct in *purpose* from
// InvestigationAction (§6.13, pedagogical/replay data scoped to a session) even though both
// are append-only. Rows are never updated or deleted by application code; the migration that
// creates this table additionally revokes UPDATE/DELETE grants on it from the app's own DB
// role (§15.11) as defense-in-depth against a compromised app server tampering with its own
// audit trail — so nothing in this codebase should ever call `.update()`/`.delete()` on it.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorIp       String?  @map("actor_ip")
  action        String
  targetType    String?  @map("target_type")
  targetId      String?  @map("target_id") @db.Uuid
  metadata      Json?
  correlationId String?  @map("correlation_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([action])
  @@index([occurredAt])
  @@map("audit_logs")
}

// ---------- Instructor Mode (§2.15, §6.5, §6.6, §6.20) ----------

enum EnrollmentStatus {
  active
  dropped
}

model Cohort {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  name      String
  joinCode  String?   @unique @map("join_code")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  owner       User                       @relation("CohortOwner", fields: [ownerId], references: [id])
  enrollments CohortEnrollment[]
  assignments CohortScenarioAssignment[]

  @@map("cohorts")
}

model CohortEnrollment {
  id         String           @id @default(uuid()) @db.Uuid
  cohortId   String           @map("cohort_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  enrolledAt DateTime         @default(now()) @map("enrolled_at")
  status     EnrollmentStatus @default(active)

  cohort Cohort @relation(fields: [cohortId], references: [id])
  user   User   @relation("CohortEnrollments", fields: [userId], references: [id])

  @@unique([cohortId, userId])
  @@map("cohort_enrollments")
}

model CohortScenarioAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  cohortId     String    @map("cohort_id") @db.Uuid
  scenarioId   String    @map("scenario_id") @db.Uuid
  dueAt        DateTime? @map("due_at")
  attemptLimit Int?      @map("attempt_limit")
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  cohort   Cohort                 @relation(fields: [cohortId], references: [id])
  scenario AttackScenario         @relation(fields: [scenarioId], references: [id])
  creator  User                   @relation("AssignmentCreator", fields: [createdBy], references: [id])
  sessions InvestigationSession[]

  @@index([cohortId])
  @@map("cohort_scenario_assignments")
}

model InstructorFeedback {
  id              String   @id @default(uuid()) @db.Uuid
  incidentId      String   @map("incident_id") @db.Uuid
  instructorId    String   @map("instructor_id") @db.Uuid
  rubricOverrides Json?    @map("rubric_overrides")
  comment         String?
  reopenedSession Boolean  @default(false) @map("reopened_session")
  createdAt       DateTime @default(now()) @map("created_at")

  incident   Incident @relation(fields: [incidentId], references: [id])
  instructor User     @relation("InstructorFeedbackAuthor", fields: [instructorId], references: [id])

  @@index([incidentId])
  @@map("instructor_feedback")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  deviceLabel       String?   @map("device_label")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @unique @map("replaced_by_token_id") @db.Uuid

  user         User          @relation(fields: [userId], references: [id])
  replacedBy   RefreshToken? @relation("RefreshTokenChain", fields: [replacedByTokenId], references: [id])
  replacedFrom RefreshToken? @relation("RefreshTokenChain")

  @@map("refresh_tokens")
}

// ---------- Scenario & Content (§6.7, §6.8) ----------

enum ScenarioCategory {
  identity
  endpoint
  email
  cloud
  insider_threat
  web
  malware
  ransomware
}

enum ScenarioDifficulty {
  beginner
  intermediate
  advanced
  expert
}

enum ScenarioStatus {
  draft
  published
  archived
}

model MitreTechnique {
  id          String  @id @default(uuid()) @db.Uuid
  techniqueId String  @unique @map("technique_id")
  name        String
  tactic      String
  description String
  url         String?

  scenarioTechniques ScenarioTechnique[]
  incidentTechniques IncidentTechnique[]
  alerts             Alert[]

  @@map("mitre_techniques")
}

model AttackScenario {
  id               String             @id @default(uuid()) @db.Uuid
  slug             String             @unique
  title            String
  summary          String
  category         ScenarioCategory
  difficulty       ScenarioDifficulty
  estimatedMinutes Int                @map("estimated_minutes")
  status           ScenarioStatus     @default(draft)
  currentVersionId String?            @unique @map("current_version_id") @db.Uuid
  authorId         String             @map("author_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  author                User                       @relation("ScenarioAuthor", fields: [authorId], references: [id])
  currentVersion        ScenarioVersion?           @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions              ScenarioVersion[]          @relation("ScenarioVersions")
  sessions              InvestigationSession[]
  cohortAssignments     CohortScenarioAssignment[]
  learningPathScenarios LearningPathScenario[]

  @@map("attack_scenarios")
}

model ScenarioVersion {
  id                    String    @id @default(uuid()) @db.Uuid
  scenarioId            String    @map("scenario_id") @db.Uuid
  versionNumber         Int       @map("version_number")
  groundTruthDefinition Json      @map("ground_truth_definition")
  publishedAt           DateTime? @map("published_at")
  createdBy             String?   @map("created_by") @db.Uuid

  scenario           AttackScenario         @relation("ScenarioVersions", fields: [scenarioId], references: [id])
  currentForScenario AttackScenario?        @relation("CurrentVersion")
  author             User?                  @relation("ScenarioVersionAuthor", fields: [createdBy], references: [id])
  techniques         ScenarioTechnique[]
  sessions           InvestigationSession[]
  threatIntel        ThreatIntelIndicator[]

  @@unique([scenarioId, versionNumber])
  @@map("scenario_versions")
}

model ScenarioTechnique {
  scenarioVersionId       String  @map("scenario_version_id") @db.Uuid
  mitreTechniqueId        String  @map("mitre_technique_id") @db.Uuid
  isRequiredForFullCredit Boolean @default(true) @map("is_required_for_full_credit")

  scenarioVersion ScenarioVersion @relation(fields: [scenarioVersionId], references: [id])
  mitreTechnique  MitreTechnique  @relation(fields: [mitreTechniqueId], references: [id])

  @@id([scenarioVersionId, mitreTechniqueId])
  @@map("scenario_techniques")
}

// ---------- Session (§6.9) ----------

enum SessionStatus {
  active
  submitted
  scored
  abandoned
}

model InvestigationSession {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String        @map("user_id") @db.Uuid
  scenarioId          String        @map("scenario_id") @db.Uuid
  scenarioVersionId   String        @map("scenario_version_id") @db.Uuid
  cohortAssignmentId  String?       @map("cohort_assignment_id") @db.Uuid
  status              SessionStatus @default(active)
  seed                BigInt
  startedAt           DateTime      @default(now()) @map("started_at")
  submittedAt         DateTime?     @map("submitted_at")
  expiresAt           DateTime      @map("expires_at")
  currentScenarioTime DateTime?     @map("current_scenario_time")

  user             User                      @relation(fields: [userId], references: [id])
  scenario         AttackScenario            @relation(fields: [scenarioId], references: [id])
  scenarioVersion  ScenarioVersion           @relation(fields: [scenarioVersionId], references: [id])
  cohortAssignment CohortScenarioAssignment? @relation(fields: [cohortAssignmentId], references: [id])

  identities           Identity[]
  devices              Device[]
  signInEvents         SignInEvent[]
  processEvents        ProcessEvent[]
  fileEvents           FileEvent[]
  networkEvents        NetworkEvent[]
  cloudEvents          CloudEvent[]
  httpRequests         HttpRequest[]
  directoryAuditEvents DirectoryAuditEvent[]
  emailMessages        EmailMessage[]
  alerts               Alert[]
  incidents            Incident[]
  investigationActions InvestigationAction[]
  score                Score?
  hintUnlocks          HintUnlock[]

  @@index([userId, status])
  @@index([scenarioId])
  @@map("investigation_sessions")
}

// ---------- Synthetic Telemetry: Identities & Devices (§6.10, §6.11) ----------

enum IdentityRiskLevel {
  none
  low
  medium
  high
}

enum MfaStatus {
  enforced
  registered_not_enforced
  not_registered
}

enum AccountStatus {
  active
  disabled
  locked
}

model Identity {
  id                 String            @id @default(uuid()) @db.Uuid
  sessionId          String            @map("session_id") @db.Uuid
  displayName        String            @map("display_name")
  userPrincipalName  String            @map("user_principal_name")
  department         String
  jobTitle           String            @map("job_title")
  managerIdentityId  String?           @map("manager_identity_id") @db.Uuid
  riskLevel          IdentityRiskLevel @default(none) @map("risk_level")
  mfaStatus          MfaStatus         @map("mfa_status")
  accountStatus      AccountStatus     @default(active) @map("account_status")
  isPrivileged       Boolean           @default(false) @map("is_privileged")
  homeCountry        String            @map("home_country")
  isGroundTruthActor Boolean           @default(false) @map("is_ground_truth_actor")

  session InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  manager Identity?            @relation("IdentityManager", fields: [managerIdentityId], references: [id])
  reports Identity[]           @relation("IdentityManager")

  primaryForDevices      Device[]
  signInEvents           SignInEvent[]
  processEvents          ProcessEvent[]
  conditionalAccessEvals ConditionalAccessEvaluation[]
  directoryAuditEvents   DirectoryAuditEvent[]        @relation("AuditTarget")
  performedAuditEvents   DirectoryAuditEvent[]        @relation("AuditActor")
  cloudEvents            CloudEvent[]

  @@index([sessionId])
  @@map("identities")
}

model ConditionalAccessEvaluation {
  id            String  @id @default(uuid()) @db.Uuid
  identityId    String  @map("identity_id") @db.Uuid
  signInEventId String? @map("sign_in_event_id") @db.Uuid
  policyName    String  @map("policy_name")
  result        String
  reasons       Json?

  identity    Identity     @relation(fields: [identityId], references: [id])
  signInEvent SignInEvent? @relation(fields: [signInEventId], references: [id])

  @@map("conditional_access_evaluations")
}

enum DirectoryAuditCategory {
  credential
  mfa
  group_membership
  role_assignment
  account_lifecycle
  mailbox_rule
}

enum DirectoryAuditResult {
  success
  failure
}

// The directory/control-plane audit trail for a simulated identity — "what was *done to* this
// account", as distinct from SignInEvent's "when did this account authenticate". Account
// takeover shows up here first: an attacker who lands a session registers their own MFA method,
// grants themselves a role, or creates a silent forwarding rule, none of which is a sign-in.
//
// Deliberately NOT the AuditLog model above: that one records real actions by real ThreatLens
// users on the real platform (§6.22). This is generated per session as part of the scenario's
// telemetry, and is torn down with it.
model DirectoryAuditEvent {
  id                    String                 @id @default(uuid()) @db.Uuid
  sessionId             String                 @map("session_id") @db.Uuid
  occurredAt            DateTime               @map("occurred_at")
  correlationId         String?                @map("correlation_id") @db.Uuid
  // The account the action was performed against.
  targetIdentityId      String                 @map("target_identity_id") @db.Uuid
  // Who performed it. Null when the directory itself acted (self-service, sync, automation),
  // which is exactly how an attacker using the victim's own session appears.
  actorIdentityId       String?                @map("actor_identity_id") @db.Uuid
  actorDisplayName      String                 @map("actor_display_name")
  category              DirectoryAuditCategory
  action                String
  result                DirectoryAuditResult   @default(success)
  detail                Json?
  sourceIp              String                 @map("source_ip")
  isGroundTruthEvidence Boolean                @default(false) @map("is_ground_truth_evidence")
  mitreTechniqueId      String?                @map("mitre_technique_id") @db.Uuid

  session        InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  targetIdentity Identity             @relation("AuditTarget", fields: [targetIdentityId], references: [id])
  actorIdentity  Identity?            @relation("AuditActor", fields: [actorIdentityId], references: [id])

  @@index([sessionId, targetIdentityId])
  @@map("directory_audit_events")
}

enum DeviceRiskLevel {
  none
  low
  medium
  high
}

enum IsolationStatus {
  not_isolated
  isolated
}

model Device {
  id                 String          @id @default(uuid()) @db.Uuid
  sessionId          String          @map("session_id") @db.Uuid
  hostname           String
  osPlatform         String          @map("os_platform")
  osVersion          String          @map("os_version")
  primaryIdentityId  String?         @map("primary_identity_id") @db.Uuid
  riskLevel          DeviceRiskLevel @default(none) @map("risk_level")
  isolationStatus    IsolationStatus @default(not_isolated) @map("isolation_status")
  lastSeenAt         DateTime        @map("last_seen_at")
  isGroundTruthActor Boolean         @default(false) @map("is_ground_truth_actor")

  session         InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  primaryIdentity Identity?            @relation(fields: [primaryIdentityId], references: [id])
  signInEvents    SignInEvent[]
  processEvents   ProcessEvent[]
  fileEvents      FileEvent[]
  networkEvents   NetworkEvent[]
  httpRequests    HttpRequest[]

  @@index([sessionId])
  @@map("devices")
}

// ---------- Telemetry Event Tables (§6.12) — skeleton subset ----------

enum SignInResult {
  success
  failure
  mfa_denied
  blocked_by_ca
}

model SignInEvent {
  id                    String       @id @default(uuid()) @db.Uuid
  sessionId             String       @map("session_id") @db.Uuid
  occurredAt            DateTime     @map("occurred_at")
  correlationId         String?      @map("correlation_id") @db.Uuid
  raw                   Json
  isGroundTruthEvidence Boolean      @default(false) @map("is_ground_truth_evidence")
  mitreTechniqueId      String?      @map("mitre_technique_id") @db.Uuid
  identityId            String       @map("identity_id") @db.Uuid
  deviceId              String?      @map("device_id") @db.Uuid
  sourceIp              String       @map("source_ip")
  sourceCountry         String       @map("source_country")
  sourceCity            String       @map("source_city")
  application           String
  result                SignInResult
  failureReason         String?      @map("failure_reason")
  isLegacyAuth          Boolean      @default(false) @map("is_legacy_auth")
  clientApp             String       @map("client_app")

  session  InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  identity Identity             @relation(fields: [identityId], references: [id])
  device   Device?              @relation(fields: [deviceId], references: [id])

  conditionalAccessEvals ConditionalAccessEvaluation[]

  @@index([sessionId, identityId, occurredAt])
  @@map("sign_in_events")
}

// §10.3: process tree, reconstructed at read time via parentProcessGuid self-reference
// within a device. Not a Prisma-level FK (a GUID isn't a row's primary key here) —
// matches the polymorphic/loosely-referenced convention already used for evidence refs.
model ProcessEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  sessionId             String   @map("session_id") @db.Uuid
  occurredAt            DateTime @map("occurred_at")
  correlationId         String?  @map("correlation_id") @db.Uuid
  raw                   Json
  isGroundTruthEvidence Boolean  @default(false) @map("is_ground_truth_evidence")
  mitreTechniqueId      String?  @map("mitre_technique_id") @db.Uuid
  deviceId              String   @map("device_id") @db.Uuid
  processGuid           String   @map("process_guid") @db.Uuid
  parentProcessGuid     String?  @map("parent_process_guid") @db.Uuid
  imagePath             String   @map("image_path")
  commandLine           String   @map("command_line")
  hashSha256            String   @map("hash_sha256")
  parentImagePath       String?  @map("parent_image_path")
  integrityLevel        String   @map("integrity_level")
  identityId            String?  @map("identity_id") @db.Uuid

  session  InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  device   Device               @relation(fields: [deviceId], references: [id])
  identity Identity?            @relation(fields: [identityId], references: [id])

  @@index([sessionId, deviceId])
  @@map("process_events")
}

enum FileEventAction {
  created
  modified
  deleted
  renamed
  encrypted
}

// §10.5: encrypted action type supports ransomware-category scenarios (§1.8).
model FileEvent {
  id                    String          @id @default(uuid()) @db.Uuid
  sessionId             String          @map("session_id") @db.Uuid
  occurredAt            DateTime        @map("occurred_at")
  correlationId         String?         @map("correlation_id") @db.Uuid
  raw                   Json
  isGroundTruthEvidence Boolean         @default(false) @map("is_ground_truth_evidence")
  mitreTechniqueId      String?         @map("mitre_technique_id") @db.Uuid
  deviceId              String          @map("device_id") @db.Uuid
  action                FileEventAction
  filePath              String          @map("file_path")
  hashSha256            String?         @map("hash_sha256")
  processGuid           String?         @map("process_guid") @db.Uuid

  session InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  device  Device               @relation(fields: [deviceId], references: [id])

  @@index([sessionId, deviceId])
  @@map("file_events")
}

enum NetworkDirection {
  inbound
  outbound
}

model NetworkEvent {
  id                    String           @id @default(uuid()) @db.Uuid
  sessionId             String           @map("session_id") @db.Uuid
  occurredAt            DateTime         @map("occurred_at")
  correlationId         String?          @map("correlation_id") @db.Uuid
  raw                   Json
  isGroundTruthEvidence Boolean          @default(false) @map("is_ground_truth_evidence")
  mitreTechniqueId      String?          @map("mitre_technique_id") @db.Uuid
  deviceId              String           @map("device_id") @db.Uuid
  direction             NetworkDirection
  protocol              String
  localPort             Int              @map("local_port")
  remoteIp              String           @map("remote_ip")
  remotePort            Int              @map("remote_port")
  bytesSent             Int              @map("bytes_sent")
  bytesReceived         Int              @map("bytes_received")
  processGuid           String?          @map("process_guid") @db.Uuid

  session InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  device  Device               @relation(fields: [deviceId], references: [id])

  @@index([sessionId, deviceId])
  @@map("network_events")
}

enum CloudProvider {
  aws_style
  azure_style
  saas
}

// §6.12.8/§1.8: identity-scoped cloud control-plane activity (IAM/API-level actions), not
// device-scoped — the same shape as sign_in_events but for cloud-provider API calls rather
// than authentication events.
model CloudEvent {
  id                    String        @id @default(uuid()) @db.Uuid
  sessionId             String        @map("session_id") @db.Uuid
  occurredAt            DateTime      @map("occurred_at")
  correlationId         String?       @map("correlation_id") @db.Uuid
  raw                   Json
  isGroundTruthEvidence Boolean       @default(false) @map("is_ground_truth_evidence")
  mitreTechniqueId      String?       @map("mitre_technique_id") @db.Uuid
  identityId            String        @map("identity_id") @db.Uuid
  provider              CloudProvider
  actionName            String        @map("action_name")
  resourceId            String?       @map("resource_id")
  sourceIp              String        @map("source_ip")

  session  InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  identity Identity             @relation(fields: [identityId], references: [id])

  @@index([sessionId, identityId])
  @@map("cloud_events")
}

// §6.12.6/§1.8: device-scoped (the web server) HTTP access log, for webshell-access and
// injection-attempt investigation narratives. `identityId` mirrors the doc's schema (a
// request can also be attributable to an authenticated identity) but is unused by the
// current scenario library — every http_request here is device-scoped only.
model HttpRequest {
  id                    String   @id @default(uuid()) @db.Uuid
  sessionId             String   @map("session_id") @db.Uuid
  occurredAt            DateTime @map("occurred_at")
  correlationId         String?  @map("correlation_id") @db.Uuid
  raw                   Json
  isGroundTruthEvidence Boolean  @default(false) @map("is_ground_truth_evidence")
  mitreTechniqueId      String?  @map("mitre_technique_id") @db.Uuid
  deviceId              String?  @map("device_id") @db.Uuid
  identityId            String?  @map("identity_id") @db.Uuid
  method                String
  url                   String
  userAgent             String   @map("user_agent")
  statusCode            Int      @map("status_code")
  sourceIp              String   @map("source_ip")

  session InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  device  Device?              @relation(fields: [deviceId], references: [id])

  @@index([sessionId, deviceId])
  @@map("http_requests")
}

enum EmailDirection {
  inbound
  outbound
  internal
}

enum SpfResult {
  pass
  fail
  softfail
  none
}

enum DkimResult {
  pass
  fail
  none
}

enum DmarcResult {
  pass
  fail
  none
}

model EmailMessage {
  id                    String         @id @default(uuid()) @db.Uuid
  sessionId             String         @map("session_id") @db.Uuid
  occurredAt            DateTime       @map("occurred_at")
  correlationId         String?        @map("correlation_id") @db.Uuid
  messageId             String         @map("message_id")
  direction             EmailDirection
  senderAddress         String         @map("sender_address")
  senderDisplayName     String         @map("sender_display_name")
  recipientAddresses    String[]       @map("recipient_addresses")
  subject               String
  bodyHtml              String         @map("body_html")
  headersRaw            Json           @map("headers_raw")
  spfResult             SpfResult      @map("spf_result")
  dkimResult            DkimResult     @map("dkim_result")
  dmarcResult           DmarcResult    @map("dmarc_result")
  isGroundTruthEvidence Boolean        @default(false) @map("is_ground_truth_evidence")
  mitreTechniqueId      String?        @map("mitre_technique_id") @db.Uuid

  // When the sending domain was first registered. Domain age is one of the strongest and most
  // objective phishing signals available — infrastructure for a campaign is typically stood up
  // days beforehand, while a real corporate domain has years of history. Nullable because a
  // resolver does not always return one, and "unknown" is itself an honest answer.
  senderDomainRegisteredAt DateTime? @map("sender_domain_registered_at")

  session     InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments EmailAttachment[]
  urls        EmailUrl[]

  @@index([sessionId])
  @@map("email_messages")
}

enum SandboxVerdict {
  benign
  suspicious
  malicious
  not_analyzed
}

model EmailAttachment {
  id             String         @id @default(uuid()) @db.Uuid
  emailMessageId String         @map("email_message_id") @db.Uuid
  filename       String
  contentType    String         @map("content_type")
  sizeBytes      Int            @map("size_bytes")
  hashSha256     String         @map("hash_sha256")
  sandboxVerdict SandboxVerdict @default(not_analyzed) @map("sandbox_verdict")

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id])

  @@map("email_attachments")
}

enum IndicatorReputation {
  malicious
  suspicious
  unknown
  known_good
}

model EmailUrl {
  id                     String              @id @default(uuid()) @db.Uuid
  emailMessageId         String              @map("email_message_id") @db.Uuid
  url                    String
  displayText            String              @map("display_text")
  reputation             IndicatorReputation @default(unknown)
  isRewrittenBySafeLinks Boolean             @default(false) @map("is_rewritten_by_safe_links")

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id])

  @@map("email_urls")
}

enum IndicatorType {
  hash
  ip
  domain
  url
}

model ThreatIntelIndicator {
  id                String              @id @default(uuid()) @db.Uuid
  scenarioVersionId String              @map("scenario_version_id") @db.Uuid
  indicatorType     IndicatorType       @map("indicator_type")
  value             String
  reputation        IndicatorReputation
  actorAttribution  String?             @map("actor_attribution")
  context           String

  scenarioVersion ScenarioVersion @relation(fields: [scenarioVersionId], references: [id])

  @@index([scenarioVersionId, indicatorType, value])
  @@map("threat_intel_indicators")
}

// ---------- Alerting (§6.15) ----------

enum AlertSeverity {
  informational
  low
  medium
  high
  critical
}

enum AlertStatus {
  new
  in_progress
  resolved
  dismissed
}

enum EntityType {
  identity
  device
  mailbox
}

model DetectionRule {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  description      String
  logicSummary     String        @map("logic_summary")
  defaultSeverity  AlertSeverity @map("default_severity")
  mitreTechniqueId String?       @map("mitre_technique_id") @db.Uuid
  isActive         Boolean       @default(true) @map("is_active")

  alerts Alert[]

  @@map("detection_rules")
}

model Alert {
  id                      String        @id @default(uuid()) @db.Uuid
  sessionId               String        @map("session_id") @db.Uuid
  title                   String
  description             String
  severity                AlertSeverity
  status                  AlertStatus   @default(new)
  dismissalReason         String?       @map("dismissal_reason")
  primaryEntityType       EntityType    @map("primary_entity_type")
  primaryEntityId         String        @map("primary_entity_id") @db.Uuid
  mitreTechniqueId        String?       @map("mitre_technique_id") @db.Uuid
  detectionRuleId         String?       @map("detection_rule_id") @db.Uuid
  dedupCount              Int           @default(1) @map("dedup_count")
  isFalsePositiveByDesign Boolean       @default(false) @map("is_false_positive_by_design")
  relatedAlertId          String?       @map("related_alert_id") @db.Uuid
  firstSeenAt             DateTime      @map("first_seen_at")
  lastSeenAt              DateTime      @map("last_seen_at")

  session        InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  detectionRule  DetectionRule?       @relation(fields: [detectionRuleId], references: [id])
  mitreTechnique MitreTechnique?      @relation(fields: [mitreTechniqueId], references: [id])
  relatedAlert   Alert?               @relation("AlertCorrelation", fields: [relatedAlertId], references: [id])
  correlatedFrom Alert[]              @relation("AlertCorrelation")

  evidenceRefs  AlertEvidenceRef[]
  incidentLinks IncidentAlert[]

  @@index([sessionId, status])
  @@map("alerts")
}

model AlertEvidenceRef {
  id         String @id @default(uuid()) @db.Uuid
  alertId    String @map("alert_id") @db.Uuid
  eventTable String @map("event_table")
  eventId    String @map("event_id") @db.Uuid

  alert Alert @relation(fields: [alertId], references: [id])

  @@map("alert_evidence_refs")
}

// ---------- Investigation (§6.13, §6.16, §6.17) ----------

enum IncidentStatus {
  open
  investigating
  contained
  closed
  reopened
}

enum IncidentVerdict {
  true_positive
  false_positive
  benign_positive
}

model Incident {
  id        String           @id @default(uuid()) @db.Uuid
  sessionId String           @map("session_id") @db.Uuid
  title     String
  status    IncidentStatus   @default(open)
  verdict   IncidentVerdict?
  summary   String?
  closedAt  DateTime?        @map("closed_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  // Which investigation-checklist steps the analyst has ticked off. The task definitions
  // themselves are static and category-derived (investigation-tasks.ts) — only the completion
  // state is per-incident, so this is a set of keys rather than rows of duplicated copy.
  completedTaskKeys String[] @default([]) @map("completed_task_keys")

  session InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  alertLinks           IncidentAlert[]
  techniqueLinks       IncidentTechnique[]
  evidenceCollection   EvidenceCollection[]
  timelineItems        TimelineItem[]
  analystNotes         AnalystNote[]
  investigationActions InvestigationAction[]
  instructorFeedback   InstructorFeedback[]

  @@index([sessionId])
  @@map("incidents")
}

model IncidentAlert {
  incidentId String   @map("incident_id") @db.Uuid
  alertId    String   @map("alert_id") @db.Uuid
  linkedAt   DateTime @default(now()) @map("linked_at")

  incident Incident @relation(fields: [incidentId], references: [id])
  alert    Alert    @relation(fields: [alertId], references: [id])

  @@id([incidentId, alertId])
  @@map("incident_alerts")
}

model IncidentTechnique {
  incidentId       String @map("incident_id") @db.Uuid
  mitreTechniqueId String @map("mitre_technique_id") @db.Uuid

  incident       Incident       @relation(fields: [incidentId], references: [id])
  mitreTechnique MitreTechnique @relation(fields: [mitreTechniqueId], references: [id])

  @@id([incidentId, mitreTechniqueId])
  @@map("incident_techniques")
}

model EvidenceCollection {
  id               String   @id @default(uuid()) @db.Uuid
  incidentId       String   @map("incident_id") @db.Uuid
  eventTable       String   @map("event_table")
  eventId          String   @map("event_id") @db.Uuid
  justification    String
  mitreTechniqueId String?  @map("mitre_technique_id") @db.Uuid
  pinnedBy         String   @map("pinned_by") @db.Uuid
  pinnedAt         DateTime @default(now()) @map("pinned_at")

  incident     Incident @relation(fields: [incidentId], references: [id])
  pinnedByUser User     @relation(fields: [pinnedBy], references: [id])

  @@map("evidence_collection")
}

// §2.9/§6.13: the "current state" table backing the Global Timeline's manually-added items —
// distinct from EvidenceCollection (which is about *relevance/proof*, §2.10) in that this is
// about *order*: a curated, addable/removable set a Student builds to reconstruct the attack
// chain, independent of whether an item is also pinned as evidence. Every add is additionally
// recorded as an `add_to_timeline` InvestigationAction (§6.13) for the replay trail — this
// table is only ever the current set, not the historical log of who-added-what-when.
model TimelineItem {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  eventTable String   @map("event_table")
  eventId    String   @map("event_id") @db.Uuid
  addedBy    String   @map("added_by") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at")

  incident    Incident @relation(fields: [incidentId], references: [id])
  addedByUser User     @relation(fields: [addedBy], references: [id])

  @@unique([incidentId, eventTable, eventId])
  @@map("timeline_items")
}

model AnalystNote {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  body       String
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  incident Incident @relation(fields: [incidentId], references: [id])
  author   User     @relation(fields: [createdBy], references: [id])

  @@map("analyst_notes")
}

enum InvestigationActionType {
  view_entity
  search
  add_to_timeline
  pin_evidence
  isolate_device
  disable_account
  block_sender
  dismiss_alert
  escalate_to_incident
  submit_verdict
  request_hint
  // Added for the ThreatLens frontend's fuller "Response actions" panel — see
  // 20260827120200_add_response_action_types.
  force_password_reset
  revoke_tokens
  block_ip
  // Recorded only when a threat-intel lookup actually matches a real indicator (see
  // 20260829140000_add_view_threat_intel) — backs a Student's own "Threat Intelligence"
  // history without ever exposing a scenario's full indicator set (its ground truth).
  view_threat_intel
}

model InvestigationAction {
  id         String                  @id @default(uuid()) @db.Uuid
  sessionId  String                  @map("session_id") @db.Uuid
  incidentId String?                 @map("incident_id") @db.Uuid
  userId     String                  @map("user_id") @db.Uuid
  actionType InvestigationActionType @map("action_type")
  targetType String                  @map("target_type")
  targetId   String                  @map("target_id") @db.Uuid
  metadata   Json?
  occurredAt DateTime                @default(now()) @map("occurred_at")

  session  InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  incident Incident?            @relation(fields: [incidentId], references: [id])
  user     User                 @relation(fields: [userId], references: [id])

  @@index([sessionId, occurredAt])
  @@index([sessionId, actionType])
  @@map("investigation_actions")
}

// ---------- Scoring (§6.14) ----------

model Score {
  id                       String   @id @default(uuid()) @db.Uuid
  sessionId                String   @unique @map("session_id") @db.Uuid
  overallPercent           Decimal  @map("overall_percent") @db.Decimal(5, 2)
  techniqueAccuracyPercent Decimal  @map("technique_accuracy_percent") @db.Decimal(5, 2)
  evidencePrecisionPercent Decimal  @map("evidence_precision_percent") @db.Decimal(5, 2)
  evidenceRecallPercent    Decimal  @map("evidence_recall_percent") @db.Decimal(5, 2)
  falsePositiveCount       Int      @map("false_positive_count")
  hintPenaltyPercent       Decimal  @map("hint_penalty_percent") @db.Decimal(5, 2)
  timeToResolutionSeconds  Int      @map("time_to_resolution_seconds")
  verdictCorrect           Boolean  @map("verdict_correct")
  rubricBreakdown          Json     @map("rubric_breakdown")
  scoredAt                 DateTime @default(now()) @map("scored_at")

  session InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("scores")
}

// §12.5: which of a scenario's authored hints (ground_truth_definition.hints, §12.1) a
// session has unlocked. Hints aren't first-class rows anywhere else — they live inside the
// JSONB ground-truth definition, addressed by array index — so this table is what lets a
// hint accrue a real, session-scoped, non-reversible score penalty.
model HintUnlock {
  id                String   @id @default(uuid()) @db.Uuid
  sessionId         String   @map("session_id") @db.Uuid
  hintIndex         Int      @map("hint_index")
  unlockCostPercent Decimal  @map("unlock_cost_percent") @db.Decimal(5, 2)
  unlockedAt        DateTime @default(now()) @map("unlocked_at")

  session InvestigationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, hintIndex])
  @@map("hint_unlocks")
}

// ---------- Learning Platform (§13, §6.18, §6.21) ----------

enum CareerTrack {
  soc_analyst
  blue_team
}

model Course {
  id          String      @id @default(uuid()) @db.Uuid
  slug        String      @unique
  title       String
  description String
  careerTrack CareerTrack @map("career_track")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  learningPaths LearningPath[]

  @@map("courses")
}

model LearningPath {
  id                   String   @id @default(uuid()) @db.Uuid
  slug                 String   @unique
  courseId             String   @map("course_id") @db.Uuid
  title                String
  passThresholdPercent Decimal  @map("pass_threshold_percent") @db.Decimal(5, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  course       Course                 @relation(fields: [courseId], references: [id])
  scenarios    LearningPathScenario[]
  certificates Certificate[]

  @@map("learning_paths")
}

model LearningPathScenario {
  learningPathId String @map("learning_path_id") @db.Uuid
  scenarioId     String @map("scenario_id") @db.Uuid
  sortOrder      Int    @map("sort_order")

  learningPath LearningPath   @relation(fields: [learningPathId], references: [id])
  scenario     AttackScenario @relation(fields: [scenarioId], references: [id])

  @@id([learningPathId, scenarioId])
  @@map("learning_path_scenarios")
}

// §6.18/§2.18. Deliberately no `pdf_object_key`/object-storage pipeline here — the public
// verification page (§16.15 `/public/verify/{id}`) itself is the shareable artifact; a
// server-rendered downloadable PDF is a real but separable piece of work this scope skips
// (would need a headless-browser rendering dependency with no other use in the codebase).
model Certificate {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  learningPathId String    @map("learning_path_id") @db.Uuid
  issuedAt       DateTime  @default(now()) @map("issued_at")
  scoreSnapshot  Json      @map("score_snapshot")
  revokedAt      DateTime? @map("revoked_at")

  user         User         @relation(fields: [userId], references: [id])
  learningPath LearningPath @relation(fields: [learningPathId], references: [id])

  @@unique([userId, learningPathId])
  @@map("certificates")
}

enum AchievementKey {
  first_blood
  perfect_score
  sharpshooter
  technique_master
  verdict_veteran
  no_hints_needed
  category_explorer
}

// §Phase 6 (merge plan): net-new, computed the same check-and-issue way certificates are —
// re-evaluated after every scoring run (not just the first) so a later session can still earn
// one it missed. Every definition reads only Score's own aggregate fields (overallPercent,
// evidencePrecisionPercent, etc.) or session/scenario counts — never a raw ground-truth field,
// same boundary the rest of the student-facing surface holds to.
model Achievement {
  id       String         @id @default(uuid()) @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  key      AchievementKey
  earnedAt DateTime       @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("achievements")
}

// §Phase 6 (merge plan): net-new. Only categories with a real backend trigger are modeled —
// deliberately excludes ThreatLens's original mock categories with no backing event yet
// (new-scenario, deadline, cohort-announcement, billing, security); add those only once the
// feature that would actually fire them exists. `link` is a same-origin app path the client
// navigates to on click (e.g. "/app/cases/<sessionId>"), never an absolute URL.
enum NotificationCategory {
  assignment
  score_available
  instructor_feedback
  certificate_issued
  org_invitation
  // Added alongside SOC Career Progression — a real trigger now exists
  // (career-progression.service.ts fires this on a level-up), matching the
  // project's own rule of only adding a category once something real emits it.
  career_milestone
}

model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  title     String
  body      String
  link      String?
  read      Boolean              @default(false)
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}
