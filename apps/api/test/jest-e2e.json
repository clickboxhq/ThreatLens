{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(?:@scure|@noble|@otplib|otplib|htmlparser2|entities|domhandler|domutils|domelementtype|dom-serializer)/)"
  ],
  "testTimeout": 120000
}
