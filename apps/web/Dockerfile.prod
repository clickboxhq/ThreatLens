# Built from the REPO ROOT (see infra/docker-compose.prod.yml's `context: ..`) — same reason
# as apps/api/Dockerfile.prod: npm workspaces, one lockfile at the root, `npm ci` needs it.

# ---- build: produces a static bundle ----
FROM node:22-alpine AS build
WORKDIR /repo
COPY package*.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci
COPY apps/web apps/web
# VITE_-prefixed vars are inlined into the JS bundle at `vite build` time, unlike the dev
# server where they're read at request time — so this must be a build ARG, not a runtime
# `environment:` value like the dev service uses.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build --workspace=apps/web

# ---- production: static assets served by nginx ----
FROM nginx:1.27-alpine AS production
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/health || exit 1
