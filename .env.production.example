# Copy to .env.production on the VPS and fill in (infra/DEPLOY.md). Never commit the real file
# — it's covered by .gitignore's `.env.*` pattern. Consumed by
# `docker compose -f infra/docker-compose.prod.yml --env-file .env.production ...`.

# TLS + routing (infra/nginx/templates/default.conf.template)
DOMAIN=socverse.example.com
LETSENCRYPT_EMAIL=ops@example.com

# Postgres superuser (POSTGRES_USER is fixed as `socverse` in docker-compose.prod.yml) — used
# to init the `postgres` service itself and, via MIGRATE_DATABASE_URL (composed from this in
# docker-compose.prod.yml), by the `migrate` service to run DDL. Pick a strong, unique value.
POSTGRES_PASSWORD=change-me-strong-password

# The app's own runtime connection, as the least-privilege `socverse_app` role (§15.9).
# prisma/migrations/20260806001500_add_least_privilege_app_role creates this role with a
# hardcoded placeholder password baked into that already-applied, forward-only migration file
# — migrations are committed to the repo and checksum-verified on every future run, so they
# can never hold a real per-environment secret. The `migrate` service's command
# (apps/api/scripts/provision-app-role.sh) rotates the role to THIS password automatically,
# every deploy, right after running migrations — no manual rotation step needed. Pick a strong
# value distinct from POSTGRES_PASSWORD.
APP_DB_PASSWORD=change-me-strong-password-2

# Object storage (MinIO, self-hosted on the same VPS, not exposed to the internet — only the
# `app` container talks to it, over the compose network).
OBJECT_STORAGE_ACCESS_KEY=socverse
OBJECT_STORAGE_SECRET_KEY=change-me-strong-secret

# Auth (§5.7, §15.1) — generate with e.g. `openssl rand -base64 48`; must differ from dev.
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Email verification / password reset (apps/api/src/common/email/email.service.ts), via Resend
# (resend.com/api-keys). Without this, api still runs, but both flows only log the link
# server-side instead of emailing it — fine for internal testing, not for real users.
RESEND_API_KEY=change-me
EMAIL_FROM=ThreatLens <onboarding@resend.dev>

# Observability (§5.16) — Grafana admin login. Grafana itself is bound to 127.0.0.1:3001 only
# (infra/DEPLOY.md's "Observability" section), reached via SSH tunnel, not public internet —
# still pick a real password, not something guessable.
GRAFANA_ADMIN_PASSWORD=change-me-strong-password-3
